# Published image. Override this for Docker Hub or a local build tag.
PTD_IMAGE=ghcr.io/markussela/poketokendocker:0.1.1

# Docker-host path containing the Hermes data directory.
# Replace this placeholder before starting Compose.
PTD_HERMES_DIR=/absolute/path/to/hermes-data

# Companion state directory, resolved relative to docker/compose.yaml.
PTD_DATA_DIR=../data

# The default profile is loopback-only and read-only.
PTD_BIND_HOST=127.0.0.1
PTD_ALLOWED_HOSTS=127.0.0.1,localhost,::1
PTD_WEB_MODE=public-readonly
PTD_WEB_ALLOW_MUTATIONS=0

# Optional: allow the Mini view to be embedded by one exact origin.
# PTD_EMBED_ORIGIN=
